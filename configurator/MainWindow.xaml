<Window x:Class="Termometriya.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфигуратор Termometriya"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Band="1" BandIndex="1">
            <Label Content="Сервер:" FontWeight="Bold"/>
            <TextBox x:Name="ServerUrlBox" Width="200" Text="http://localhost:5000" ToolTip="URL сервера"/>
            <Separator/>
            <Button x:Name="LoadBtn" Content="Загрузить" Click="LoadBtn_Click" ToolTip="Загрузить конфигурации с сервера"/>
            <Button x:Name="SaveBtn" Content="Сохранить" Click="SaveBtn_Click" ToolTip="Сохранить все изменения на сервер"/>
            <Separator/>
            <Button x:Name="LoadElevBtn" Content="Загрузить элеватор" Click="LoadElevBtn_Click"/>
            <Button x:Name="SaveElevBtn" Content="Сохранить элеватор" Click="SaveElevBtn_Click"/>
            <Separator/>
            <Button x:Name="LoadHwBtn" Content="Загрузить БКТ-12" Click="LoadHwBtn_Click"/>
            <Button x:Name="SaveHwBtn" Content="Сохранить БКТ-12" Click="SaveHwBtn_Click"/>
        </ToolBar>

        <!-- Tab content -->
        <TabControl Grid.Row="1" Margin="6">
            <TabItem Header="Конфигурация элеватора">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: TreeView -->
                    <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="1" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                                <Button Content="+ Культура" Click="AddCulture_Click" Margin="0,0,4,0" Padding="6,2"/>
                                <Button Content="- Культура" Click="DeleteCulture_Click" Padding="6,2"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="CulturesGrid" AutoGenerateColumns="False"
                                      HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="180"
                                      SelectionChanged="CulturesGrid_SelectionChanged"
                                      RowHeaderWidth="0" Margin="4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Культуры" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Порог °C" Binding="{Binding WarnTemp}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Visibility="Collapsed"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,4,4">
                                <Button Content="+ Линия" Click="AddLine_Click" Margin="0,0,4,0" Padding="6,2"/>
                                <Button Content="- Линия" Click="DeleteLine_Click" Padding="6,2"/>
                            </StackPanel>

                            <TreeView Grid.Row="2" x:Name="ElevatorTree" Margin="4,28,4,4"
                                      SelectedItemChanged="ElevatorTree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Silos}">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Pendants}">
                                                <TextBlock Text="{Binding Number, StringFormat='Силос №{0}'}"/>
                                                <HierarchicalDataTemplate.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding PositionIndex, StringFormat='Подвеска [pos={0}]'}"/>
                                                    </DataTemplate>
                                                </HierarchicalDataTemplate.ItemTemplate>
                                            </HierarchicalDataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,4,4">
                                <Button x:Name="AddSiloBtn" Content="+ Силос" Click="AddSilo_Click" Margin="0,0,4,0" Padding="6,2"/>
                                <Button x:Name="DelSiloBtn" Content="- Силос" Click="DeleteSilo_Click" Padding="6,2"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right" Margin="4,0,4,4">
                                <Button x:Name="AddPendantBtn" Content="+ Подвеска" Click="AddPendant_Click" Margin="0,0,4,0" Padding="6,2"/>
                                <Button x:Name="DelPendantBtn" Content="- Подвеска" Click="DeletePendant_Click" Padding="6,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Property editor -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ElevatorProps" Margin="6">
                            <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,6">Культура</TextBlock>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0">Название:</Label>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCulture.Name, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="1" Grid.Column="0">NormTemp:</Label>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCulture.NormTemp, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="2" Grid.Column="0">WarnTemp:</Label>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCulture.WarnTemp, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="3" Grid.Column="0">CriticalTemp:</Label>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCulture.CriticalTemp, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="4" Grid.Column="0">GradientWarn:</Label>
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCulture.GradientWarn, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="5" Grid.Column="0">GradientCritical:</Label>
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCulture.GradientCritical, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="6" Grid.Column="0">DeviationThreshold:</Label>
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedCulture.DeviationThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="7" Grid.Column="0">HighTempThreshold:</Label>
                                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SelectedCulture.HighTempThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="8" Grid.Column="0">HighTempGradient:</Label>
                                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedCulture.HighTempGradient, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="9" Grid.Column="0">CriticalHighTemp50:</Label>
                                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedCulture.CriticalHighTemp50, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,6">Силос</TextBlock>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0">Номер:</Label>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSilo.Number, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="1" Grid.Column="0">Загрузка %:</Label>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSilo.FillLevel, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="2" Grid.Column="0">Ёмкость:</Label>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSilo.Capacity, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="3" Grid.Column="0">Культура:</Label>
                                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CultureCombo" IsEditable="True"
                                                  Text="{Binding SelectedSilo.CultureName, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#ddd" BorderThickness="1" Padding="8">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,6">Подвеска</TextBlock>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0">PositionIndex:</Label>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPendant.PositionIndex, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <Label Grid.Row="1" Grid.Column="0">PointCount:</Label>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPendant.PointCount, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                                        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding SelectedPendant.IsCentral}" Content="Центральная" Margin="2" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Оборудование БКТ-12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: TreeView -->
                    <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="1" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                                <Button Content="+ Линия" Click="AddBkt12Line_Click" Margin="0,0,4,0" Padding="6,2"/>
                                <Button Content="- Линия" Click="DeleteBkt12Line_Click" Padding="6,2"/>
                            </StackPanel>

                            <TreeView Grid.Row="1" x:Name="Bkt12Tree" Margin="4" SelectedItemChanged="Bkt12Tree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Blocks}">
                                        <TextBlock Text="{Binding LineNumber, StringFormat='Линия {0}'}" FontWeight="Bold"/>
                                        <HierarchicalDataTemplate.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SlaveId, StringFormat='Блок slaveId={0}'}"/>
                                            </DataTemplate>
                                        </HierarchicalDataTemplate.ItemTemplate>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4">
                                <Button x:Name="AddBlockBtn" Content="+ Блок" Click="AddBkt12Block_Click" Margin="0,0,4,0" Padding="6,2"/>
                                <Button x:Name="DelBlockBtn" Content="- Блок" Click="DeleteBkt12Block_Click" Padding="6,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                        <!-- Right: Block properties + Thermopendants grid -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedBkt12Block}">
                            <StackPanel Margin="4" MinWidth="350">
                                <Border BorderBrush="#ddd" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,4">Параметры блока</TextBlock>
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Padding="2">Slave ID:</Label>
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SlaveId}" Margin="1" Height="24"/>
                                            <Label Grid.Row="1" Grid.Column="0" Padding="2">Sim Port:</Label>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SimulationPort}" Margin="1" Height="24"/>
                                            <Label Grid.Row="2" Grid.Column="0" Padding="2">Соединение:</Label>
                                            <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True"
                                                      Text="{Binding ConnectionType, UpdateSourceTrigger=PropertyChanged}" Margin="1" Height="24">
                                                <ComboBoxItem Content="simulation"/>
                                                <ComboBoxItem Content="tcp"/>
                                                <ComboBoxItem Content="rtu"/>
                                            </ComboBox>
                                            <Label Grid.Row="3" Grid.Column="0" Padding="2">Host/IP:</Label>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Host}" Margin="1" Height="24"/>
                                            <Label Grid.Row="4" Grid.Column="0" Padding="2">Port:</Label>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Port}" Margin="1" Height="24"/>
                                            <Label Grid.Row="5" Grid.Column="0" Padding="2">COM-порт:</Label>
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PortName}" Margin="1" Height="24"/>
                                            <Label Grid.Row="6" Grid.Column="0" Padding="2">Silo IDs:</Label>
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SiloIdsStr}" Margin="1" Height="24" ToolTip="Через запятую, напр. 1, 2"/>
                                            <Label Grid.Row="7" Grid.Column="0" Padding="2">BaseReg:</Label>
                                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding BaseRegister}" Margin="1" Height="24"/>
                                            <Label Grid.Row="8" Grid.Column="0" Padding="2">Regs/Pend:</Label>
                                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding RegistersPerPendant}" Margin="1" Height="24"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderBrush="#ddd" BorderThickness="1" Padding="6">
                                    <StackPanel DataContext="{Binding}">
                                        <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,4">Термоподвески в блоке</TextBlock>
                                        <DataGrid x:Name="ThermoGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="250" MinHeight="100">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PositionIndex" Binding="{Binding PositionIndex, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                <DataGridTextColumn Header="PointCount" Binding="{Binding PointCount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="+ Добавить" Click="AddThermoSlot_Click" Margin="0,0,4,0" Padding="6,2"/>
                                            <Button Content="- Удалить" Click="DeleteThermoSlot_Click" Padding="6,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Управление сервером">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0">Путь к .exe:</Label>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ServerPathBox" Margin="2"/>
                                <Button Grid.Column="1" Content="..." Click="BrowseExe_Click" Padding="6,2" Margin="2"/>
                            </Grid>
                            <Label Grid.Row="1" Grid.Column="0">Аргументы:</Label>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ServerArgsBox" Text="--urls http://0.0.0.0:5000" Margin="2"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="StartBtn" Content="Запустить" Click="StartServer_Click" Padding="10,4" Margin="0,0,6,0" Width="120"/>
                        <Button x:Name="StopBtn" Content="Остановить" Click="StopServer_Click" Padding="10,4" Margin="0,0,6,0" Width="120"/>
                        <Button Content="Перезапустить" Click="RestartServer_Click" Padding="10,4" Width="120"/>
                        <TextBlock x:Name="ServerStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontWeight="Bold" FontSize="14"/>
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="#ddd" BorderThickness="1" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontWeight="Bold" Margin="4">Вывод сервера:</TextBlock>
                            <ListBox Grid.Row="1" x:Name="ServerOutputBox"
                                     Background="#1e1e2e" Foreground="#ccc" FontFamily="Consolas" FontSize="12"
                                     VirtualizingPanel.ScrollUnit="Pixel"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
