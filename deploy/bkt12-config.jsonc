{
  // ==============================================================
  // КОНФИГУРАЦИЯ ОБОРУДОВАНИЯ БКТ-12 (МОДБУС)
  // ==============================================================
  // Формат: JSON с комментариями (JSONC).
  // Система термометрии элеватора: 3 линии × 4 силоса = 12 силосов.
  // Каждая линия обслуживается 2 блоками БКТ-12 (всего 6 блоков).
  // Каждый блок БКТ-12 — это Modbus Slave с уникальным Slave ID.
  //
  // Карта регистров (Modbus Holding Registers, функция 03):
  //   - Базовый регистр: 15 (первые 14 регистров зарезервированы)
  //   - Каждая термоподвеска занимает 30 регистров
  //   - 1 регистр = целое число со знаком / 16 = температура в °C
  //   - Big-endian (старший байт первым)
  //   - CRC-16 (младший байт первым)
  //   - Регистры 375+ зарезервированы
  // ==============================================================

  "lines": [
    // ---- ЛИНИЯ 1 -------------------------------------------------
    {
      "lineNumber": 1,        // Номер линии (1-3)
      "blocks": [
        // Блок БКТ-12 #1 (силосы 1 и 2)
        {
          "slaveId": 1,              // Modbus Slave ID (1-247)
          "simulationPort": 1501,    // Порт для симуляции (TCP)
          "connection": {
            "type": "simulation",    // "simulation" | "rtu" | "tcp"
            "host": "192.168.1.101", // IP-адрес для TCP-подключения
            "port": 502              // Порт Modbus TCP (по умолч. 502)
            // Для RTU (RS-485):
            // "portName": "COM1",
            // "baudRate": 9600,
            // "dataBits": 8,
            // "parity": "None",
            // "stopBits": "One"
          },
          "siloIds": [1, 2],         // Какие силосы подключены к этому блоку
          "registerMap": {
            "baseRegister": 15,          // Первый регистр данных
            "registersPerPendant": 30,   // Регистров на одну подвеску
            "thermopendants": [
              // ---- Силос 1 (6 подвесок) ----
              { "positionIndex": 0, "pointCount": 18 }, // Центральная (18 точек)
              { "positionIndex": 1, "pointCount": 16 }, // Периферийная #1
              { "positionIndex": 2, "pointCount": 16 }, // Периферийная #2
              { "positionIndex": 3, "pointCount": 16 }, // Периферийная #3
              { "positionIndex": 4, "pointCount": 16 }, // Периферийная #4
              { "positionIndex": 5, "pointCount": 16 }, // Периферийная #5
              // ---- Силос 2 (6 подвесок) ----
              { "positionIndex": 6, "pointCount": 18 }, // Центральная (вход 6)
              { "positionIndex": 7, "pointCount": 16 }, // Периферийная #1 (вход 7)
              { "positionIndex": 8, "pointCount": 16 },
              { "positionIndex": 9, "pointCount": 16 },
              { "positionIndex": 10, "pointCount": 16 },
              { "positionIndex": 11, "pointCount": 16 }
            ]
          }
        },
        // Блок БКТ-12 #2 (силосы 3 и 4)
        {
          "slaveId": 2,
          "simulationPort": 1502,
          "connection": { "type": "simulation" },
          "siloIds": [3, 4],
          "registerMap": {
            "baseRegister": 15,
            "registersPerPendant": 30,
            "thermopendants": [
              { "positionIndex": 0, "pointCount": 18 }, // Силос 3, центр
              { "positionIndex": 1, "pointCount": 16 },
              { "positionIndex": 2, "pointCount": 16 },
              { "positionIndex": 3, "pointCount": 16 },
              { "positionIndex": 4, "pointCount": 16 },
              { "positionIndex": 5, "pointCount": 16 },
              { "positionIndex": 6, "pointCount": 18 }, // Силос 4, центр (вход 6)
              { "positionIndex": 7, "pointCount": 16 },
              { "positionIndex": 8, "pointCount": 16 },
              { "positionIndex": 9, "pointCount": 16 },
              { "positionIndex": 10, "pointCount": 16 },
              { "positionIndex": 11, "pointCount": 16 }
            ]
          }
        }
      ]
    },

    // ---- ЛИНИЯ 2 -------------------------------------------------
    {
      "lineNumber": 2,
      "blocks": [
        {
          "slaveId": 3,
          "simulationPort": 1503,
          "connection": { "type": "simulation" },
          "siloIds": [5, 6],
          "registerMap": {
            "baseRegister": 15,
            "registersPerPendant": 30,
            "thermopendants": [
              { "positionIndex": 0, "pointCount": 18 },
              { "positionIndex": 1, "pointCount": 16 },
              { "positionIndex": 2, "pointCount": 16 },
              { "positionIndex": 3, "pointCount": 16 },
              { "positionIndex": 4, "pointCount": 16 },
              { "positionIndex": 5, "pointCount": 16 },
              { "positionIndex": 6, "pointCount": 18 },
              { "positionIndex": 7, "pointCount": 16 },
              { "positionIndex": 8, "pointCount": 16 },
              { "positionIndex": 9, "pointCount": 16 },
              { "positionIndex": 10, "pointCount": 16 },
              { "positionIndex": 11, "pointCount": 16 }
            ]
          }
        },
        {
          "slaveId": 4,
          "simulationPort": 1504,
          "connection": { "type": "simulation" },
          "siloIds": [7, 8],
          "registerMap": {
            "baseRegister": 15,
            "registersPerPendant": 30,
            "thermopendants": [
              { "positionIndex": 0, "pointCount": 18 },
              { "positionIndex": 1, "pointCount": 16 },
              { "positionIndex": 2, "pointCount": 16 },
              { "positionIndex": 3, "pointCount": 16 },
              { "positionIndex": 4, "pointCount": 16 },
              { "positionIndex": 5, "pointCount": 16 },
              { "positionIndex": 6, "pointCount": 18 },
              { "positionIndex": 7, "pointCount": 16 },
              { "positionIndex": 8, "pointCount": 16 },
              { "positionIndex": 9, "pointCount": 16 },
              { "positionIndex": 10, "pointCount": 16 },
              { "positionIndex": 11, "pointCount": 16 }
            ]
          }
        }
      ]
    },

    // ---- ЛИНИЯ 3 -------------------------------------------------
    {
      "lineNumber": 3,
      "blocks": [
        {
          "slaveId": 5,
          "simulationPort": 1505,
          "connection": { "type": "simulation" },
          "siloIds": [9, 10],
          "registerMap": {
            "baseRegister": 15,
            "registersPerPendant": 30,
            "thermopendants": [
              { "positionIndex": 0, "pointCount": 18 },
              { "positionIndex": 1, "pointCount": 16 },
              { "positionIndex": 2, "pointCount": 16 },
              { "positionIndex": 3, "pointCount": 16 },
              { "positionIndex": 4, "pointCount": 16 },
              { "positionIndex": 5, "pointCount": 16 },
              { "positionIndex": 6, "pointCount": 18 },
              { "positionIndex": 7, "pointCount": 16 },
              { "positionIndex": 8, "pointCount": 16 },
              { "positionIndex": 9, "pointCount": 16 },
              { "positionIndex": 10, "pointCount": 16 },
              { "positionIndex": 11, "pointCount": 16 }
            ]
          }
        },
        {
          "slaveId": 6,
          "simulationPort": 1506,
          "connection": { "type": "simulation" },
          "siloIds": [11, 12],
          "registerMap": {
            "baseRegister": 15,
            "registersPerPendant": 30,
            "thermopendants": [
              { "positionIndex": 0, "pointCount": 18 },
              { "positionIndex": 1, "pointCount": 16 },
              { "positionIndex": 2, "pointCount": 16 },
              { "positionIndex": 3, "pointCount": 16 },
              { "positionIndex": 4, "pointCount": 16 },
              { "positionIndex": 5, "pointCount": 16 },
              { "positionIndex": 6, "pointCount": 18 },
              { "positionIndex": 7, "pointCount": 16 },
              { "positionIndex": 8, "pointCount": 16 },
              { "positionIndex": 9, "pointCount": 16 },
              { "positionIndex": 10, "pointCount": 16 },
              { "positionIndex": 11, "pointCount": 16 }
            ]
          }
        }
      ]
    }
  ]
}
